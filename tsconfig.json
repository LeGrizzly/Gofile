{
	"compilerOptions": {
		"target": "es2024",
		"module": "NodeNext",
		"lib": ["es2024"],
		"types": ["node"],
		"moduleResolution": "nodenext",
		"ignoreDeprecations": "6.0",
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
