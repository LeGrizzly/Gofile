{
	"name": "gofile",
	"version": "1.0.5",
	"description": "Simple API for uploading files to Gofile.io",
	"license": "ISC",
	"author": "LeGrizzly",
	"type": "module",
	"main": "dist/index.js",
	"files": [
		"dist/**/*",
		"README.md",
		"package.json"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xalsie/gofile.git"
	},
	"homepage": "https://github.com/xalsie/gofile#readme",
	"bugs": {
		"url": "https://github.com/xalsie/gofile/issues"
	},
	"keywords": [
		"gofile",
		"upload",
		"api",
		"file-upload"
	],
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "tsc --watch",
		"test": "npm run build && node dist/tests/test.js",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:format": "prettier --write .",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@eslint/js": "^9.31.0",
		"@eslint/markdown": "^7.0.0",
		"@types/node": "^24.0.13",
		"@typescript-eslint/eslint-plugin": "^8.36.0",
		"@typescript-eslint/parser": "^8.36.0",
		"eslint": "^9.31.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-prettier": "^5.5.1",
		"globals": "^16.3.0",
		"prettier": "^3.6.2",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.36.0"
	},
	"engines": {
		"node": ">=24.0.0"
	}
