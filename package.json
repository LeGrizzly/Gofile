{
	"name": "@LeGrizzly/gofile",
	"version": "1.0.12",
	"description": "Simple API for uploading files to Gofile.io",
	"license": "ISC",
	"author": "LeGrizzly",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist/**/*",
		"README.md",
		"package.json"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LeGrizzly/gofile.git"
	},
	"homepage": "https://github.com/LeGrizzly/gofile#readme",
	"bugs": {
		"url": "https://github.com/LeGrizzly/gofile/issues"
	},
	"keywords": [
		"gofile",
		"upload",
		"api",
		"file-upload"
	],
	"scripts": {
		"build": "tsc",
		"copy": "node scripts/copy-file.ts",
		"build:copy": "npm run build && npm run copy",
		"start": "node dist/index.js",
		"dev": "tsc --watch",
		"test": "npm run build && node dist/tests/index.js && node --test scripts/*.test.ts",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:format": "biome format --write .",
		"format": "biome format --write .",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^26.6.6",
		"ts-node": "^10.9.2",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
